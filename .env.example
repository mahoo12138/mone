# Required in every build that should show real data, including preview deployments.
# Without these two, a production build renders the "not configured" screen instead of data.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Sample data is a local development default. Set this only for a build you deliberately
# want to publish as a demo; the workspace then labels itself as demo data throughout.
# VITE_DEMO_MODE=true
